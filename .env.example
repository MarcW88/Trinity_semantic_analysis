# PostgreSQL (Neon via the Vercel Marketplace in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dedecker
# openssl rand -base64 32
AUTH_SECRET=
# Optional: initial administrator created by `npm run db:migrate` (password >= 10 chars, never commit it)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: comma-separated DeDecker domains counted as GEO citations (default: dedecker.be)
CLIENT_DOMAINS=dedecker.be
# Private Vercel Blob store for uploaded workbooks (unset = local ./storage, development only)
BLOB_READ_WRITE_TOKEN=
